    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "在所选时段结束时刻查询各端口的 USB 输出功率并加总。功率由电压（mV）乘电流（mA）后除以 1,000,000 得出。",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "unit": "watt",
          "noValue": "—"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(ionbridge_port_voltage{instance=~\"$instance\"} * ionbridge_port_current{instance=~\"$instance\"}) / 1000000",
          "instant": true,
          "legendFormat": "总计",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "⚡ 当前总功率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
